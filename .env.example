# Agents Chat 环境配置（复制为 .env 后按需修改；.env 已被 git 忽略，可安全填入密钥）

# ---------- 执行内核（四选一，自动检测安装） ----------
# 内核选择：auto=按检测顺序自动（OpenCode → Claude Code → Codex → pi）
# AGENTS_CHAT_KERNEL=auto
# 指定内核完整路径（命令不在 PATH 时用）
# AGENTS_CHAT_OPENCODE_CMD=
# AGENTS_CHAT_CLAUDE_CMD=
# AGENTS_CHAT_CODEX_CMD=
# AGENTS_CHAT_PI_CMD=

# ---------- 行为开关 ----------
# 单次智能体执行超时（毫秒，默认 10 分钟）
# AGENTS_CHAT_TIMEOUT_MS=600000
# 验收前自动核查：0=关闭（文件存在性/JS 语法/JSON 校验/占位符残留）
# AGENTS_CHAT_AUTOVERIFY=1
# 自定义验证命令（每轮验收前在工作目录执行，如 npm test）
# AGENTS_CHAT_VERIFY_CMD=
# 验证命令超时（毫秒，默认 120 秒）
# AGENTS_CHAT_VERIFY_TIMEOUT_MS=120000
# 管家验收不通过时最大返工轮数（默认 2）
# AGENTS_CHAT_MAX_VERIFY=2
# 智能体交接模式：doc=结构化交接文档（默认）/ full=全文拼接
# AGENTS_CHAT_HANDOFF=doc
# 圆桌讨论最大轮数（默认 2）
# AGENTS_CHAT_ROUNDTABLE_ROUNDS=2
# OpenCode 内核自动放行工具调用（默认开；群聊任务与单聊对话均生效，
# 0=关闭后非交互执行可能因权限询问卡住）
# AGENTS_CHAT_AUTO_APPROVE=1

# ---------- 辅助小模型（管家记忆整理 / 上下文压缩） ----------
# 任意 OpenAI 兼容接口（如 SiliconFlow / DeepSeek / 本地 vLLM），全部留空 = 关闭
# 未配置时记忆照常工作（写满自动淘汰最旧条目），仅跳过需要小模型的整理与压缩
AGENTS_CHAT_AUX_BASE_URL=https://api.siliconflow.cn/v1
AGENTS_CHAT_AUX_MODEL=Qwen/Qwen3-8B
AGENTS_CHAT_AUX_API_KEY=your-api-key-here

# 管家长期记忆：1=开启（默认）/ 0=关闭
# AGENTS_CHAT_MEMORY=1

# ---------- 页面全关自动退出（v3.14.0） ----------
# 1=开启（默认）：全部页面关闭且无执行/审批等待时，空闲约 1 分钟自动退出
# （例外：存在待触发的定时任务时保持存活，任务触发并执行完成后才退出）
# 0=关闭：服务常驻，需手动运行 stop.bat 停止
# AGENTS_CHAT_AUTOSTOP=1
# 空闲退出阈值（毫秒，默认 50000 = 50 秒）
# AGENTS_CHAT_AUTOSTOP_IDLE_MS=50000

# ---------- 历史数据自动清理 ----------
# 任务/消息/会话/产出文件/流转日志超期自动清理（启动时+每日一次），
# 也可在「智能体配置 → 数据维护」一键手动清理；管家记忆与配置永久保留
# AGENTS_CHAT_PRUNE_DAYS=15

# ---------- 人工审批关卡（v3.11.0） ----------
# 编排在关键节点暂停等用户点「同意」（网页配置页的下拉框优先于此处设置）：
# off=关闭（默认）/ plan=调度方案确定后 / verify=最终交付前 / all=两者
# AGENTS_CHAT_APPROVAL=off
# 审批等待超时（毫秒，超时视为否决，默认 10 分钟）
# AGENTS_CHAT_APPROVAL_TIMEOUT_MS=600000

# ---------- 演示模式 ----------
# 1=模拟输出（界面体验用，不调用真实智能体）
# AGENTS_CHAT_MOCK=0
