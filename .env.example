# Agents Chat 配置示例：复制为同目录 .env 后按需修改；全部可省略

# ---- 通知 ----
# 任务/卡牌完成时转发 JSON 到该地址（钉钉/飞书自定义 bot 或自建中转均可）：
# POST {event,kind,title,status,snippet,text}，2 秒超时失败静默
# AGENTS_CHAT_WEBHOOK_URL=https://example.com/your-hook

# ---- 资源与清理 ----
# 每日滚动清理保留天数（默认 15；0 不代表关闭清理，请用大数值）
# AGENTS_CHAT_PRUNE_DAYS=15
# 单会话消息滚动上限（默认 500，0=关闭；主会话不受限）
# AGENTS_CHAT_MSG_LIMIT=500

# ---- 自动退出 ----
# 全部页面关闭且空闲后自动退出（默认开；0 关闭）
# AGENTS_CHAT_AUTOSTOP=1
# 空闲多少毫秒后退出（默认 50000）
# AGENTS_CHAT_AUTOSTOP_IDLE_MS=50000

# ---- 内核与执行 ----
# 自动安装 opencode（默认开；0 关闭）
# AGENTS_CHAT_AUTO_INSTALL=1
# 指定内核完整路径（按需）
# AGENTS_CHAT_OPENCODE_CMD=
# 单任务超时毫秒（默认 10 分钟）
# AGENTS_CHAT_TIMEOUT_MS=600000
# AI 组队生成超时（毫秒，默认 120000；真实内核生成整队提示词耗时较长）
# AGENTS_CHAT_SUGGEST_TIMEOUT_MS=120000
# AI 编排（卡牌控制台聊天编排）超时：对话（默认 120000）与生成清单（默认 180000，输出量大）
# AGENTS_CHAT_PLANNER_CHAT_TIMEOUT_MS=120000
# AGENTS_CHAT_PLANNER_PLAN_TIMEOUT_MS=180000

# ---- 附件解析（文件上传理解） ----
# Agnes 视觉理解密钥：图片类附件（png/jpg/webp/gif/bmp）靠它识别文字/图表；未配置则仅图片无法解析，其余格式照常
# AGENTS_CHAT_AGNES_KEY=sk-xxx
# Agnes 兼容端点与模型（可选，默认 https://apihub.agnes-ai.com/v1 与 agnes-2.0-flash）
# AGENTS_CHAT_AGNES_BASE=https://apihub.agnes-ai.com/v1
# AGENTS_CHAT_AGNES_MODEL=agnes-2.0-flash
# MinerU 云端解析基础地址（可选，默认 https://mineru.net/api/v1/agent；Flash 免登录免 Token）
# AGENTS_CHAT_MINERU_BASE=https://mineru.net/api/v1/agent
# 解析语言（可选，默认 ch；英文文档用 en）
# AGENTS_CHAT_MINERU_LANG=ch
# 附件上限（可选）：单条消息最多文件数 / 单文件大小 MB / 解析超时毫秒
# AGENTS_CHAT_ATT_MAX_FILES=5
# AGENTS_CHAT_ATT_MAX_BYTES=10
# AGENTS_CHAT_ATT_TIMEOUT_MS=120000
